# ------------------------------------------------------------------
# Development / testing image — hot-reload dev server for Docker Compose
# ------------------------------------------------------------------
FROM node:22-alpine

WORKDIR /app

# Install dependencies into the image (seeds the node_modules named volume)
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

EXPOSE 3000

ENV NEXT_TELEMETRY_DISABLED=1
ENV WATCHPACK_POLLING=true
ENV CHOKIDAR_USEPOLLING=true

# Safety net: if the node_modules volume is ever empty, reinstall first
CMD ["sh", "-c", "[ -d node_modules/next ] || npm ci --no-audit --no-fund; exec npm run dev"]
